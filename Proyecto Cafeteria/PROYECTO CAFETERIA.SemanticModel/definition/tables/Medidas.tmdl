table Medidas
	lineageTag: 2d5bcfcb-bed3-431a-a14a-14c7ead9d8ae

	measure VentasUSD = SUM(BD_DetalleOrdenes[Precio_venta])
		lineageTag: 4ee57fc6-4e11-4c09-88b5-e3648a567745

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Items_Vendidos = COUNTROWS(BD_DetalleOrdenes)
		formatString: 0
		lineageTag: eb776d96-da6d-4c4f-96a4-38e03998b0ce

	measure Clasificacion_Prom = AVERAGE(BD_CusReviews[rating])
		lineageTag: 27a515ad-1b3a-49b5-84e0-ecc92d595a61

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Reseñas_Positivas =
			
			DIVIDE(
			    CALCULATE(
			        COUNT(BD_CusReviews[review_id]),
			        BD_CusReviews[label] = "POSITIVE"
			    ),
			    COUNT(BD_CusReviews[review_id])
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: fe27bd3d-e372-4c60-bcad-f6b22b868160

	measure Estado_Meta_Ventas =
			
			IF ( [VentasUSD] >= 30000, "✅ Meta cumplida", "⚠ Por debajo de la meta" )
		lineageTag: e5d28a26-398c-463d-92b7-be2b62e52ece

	measure Estado_Servicio =
			
			IF([Espera_Prom] > 14, "Lento", "Excelente")
		lineageTag: 25e1c3cc-4167-4647-b584-eaa1ca040bfa

	measure Espera_prom = AVERAGE(BD_Ordenes[wait_time_min])
		lineageTag: 0b9b9822-aa24-422d-aa6f-70fa2f3d2ccc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure VentasUSD-1 = CALCULATE([VentasUSD],DATEADD(Calendario[Fecha],-1,MONTH))
		lineageTag: 8975c325-acfe-4236-bf4f-feb9d96af664

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CrecimientoMensual =
			
			VAR EsUnSoloMes = HASONEVALUE(Calendario[Mes]) && HASONEVALUE(Calendario[Año])
			VAR VentasMesAnterior = [VentasUSD-1]
			RETURN
			IF(
			    NOT EsUnSoloMes,
			    BLANK(),
			    DIVIDE([VentasUSD] - VentasMesAnterior, VentasMesAnterior)
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 49647e58-b1c6-4289-a6f6-e263cdf0cc5d

	measure Metricas_Cafeteria_HTML = ```
			
			VAR ValorVentas = FORMAT([VentasUSD], "$#,##0.00")
			VAR ValorProductos = FORMAT([Items_Vendidos], "#,##0")
			VAR ValorRating = FORMAT([Clasificacion_Prom], "0.00")
			VAR ValorEstado = [Estado_Servicio]
			
			-- Cálculo y formato de la quinta tarjeta: Crecimiento Mensual
			VAR ValCrecimiento = [CrecimientoMensual]
			VAR TextoCrecimiento = FORMAT(ValCrecimiento, "+0.00%;-0.00%;0.00%")
			
			-- Color e ícono dinámico para Crecimiento (Verde si sube, Rojo si baja)
			VAR EsPositivo = ValCrecimiento >= 0
			VAR ColorCrecimiento = IF(EsPositivo, "#107c41", "#d9381e")
			VAR ColorFondoCrecimiento = IF(EsPositivo, "#e8f5e9", "#fde8e8")
			VAR ColorBordeCrecimiento = IF(EsPositivo, "#a3e635", "#fca5a5")
			
			VAR IconoCrecimiento = 
			    IF(
			        EsPositivo,
			        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#107c41' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='23 6 13.5 15.5 8.5 10.5 1 18'></polyline><polyline points='17 6 23 6 23 12'></polyline></svg>",
			        "<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#d9381e' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='23 18 13.5 8.5 8.5 13.5 1 6'></polyline><polyline points='17 18 23 18 23 12'></polyline></svg>"
			    )
			
			VAR IconoDinamico = 
			    SWITCH(
			        LOWER(ValorEstado),
			        "excelente", "
			            <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#107c41' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>
			                <circle cx='12' cy='12' r='10'></circle>
			                <path d='M8 14s1.5 2 4 2 4-2 4-2'></path>
			                <line x1='9' y1='9' x2='9.01' y2='9'></line>
			                <line x1='15' y1='9' x2='15.01' y2='9'></line>
			            </svg>",
			        "bueno", "
			            <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#107c41' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>
			                <circle cx='12' cy='12' r='10'></circle>
			                <line x1='8' y1='15' x2='16' y2='15'></line>
			                <line x1='9' y1='9' x2='9.01' y2='9'></line>
			                <line x1='15' y1='9' x2='15.01' y2='9'></line>
			            </svg>",
			        "
			            <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#d9381e' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'>
			                <circle cx='12' cy='12' r='10'></circle>
			                <path d='M16 16s-1.5-2-4-2-4 2-4 2'></path>
			                <line x1='9' y1='9' x2='9.01' y2='9'></line>
			                <line x1='15' y1='9' x2='15.01' y2='9'></line>
			            </svg>"
			    )
			RETURN
			"
			<div style='
			    font-family: Segoe UI, sans-serif;
			    display: flex;
			    flex-direction: row;
			    gap: 40px;
			    align-items: center;
			    justify-content: center;
			    margin: 0 auto;
			'>
			    <!-- Tarjeta 1: Ventas Totales -->
			    <div style='
			        background: linear-gradient(135deg, #ffffff 0%, #e8f5e9 100%);
			        border: 1px solid #a3e635;
			        border-top: 5px solid #107c41;
			        border-radius: 12px;
			        padding: 8px 12px;
			        width: 210px;
			        height: 72px;
			        box-sizing: border-box;
			        display: flex;
			        flex-direction: column;
			        justify-content: center;
			        align-items: center;
			        text-align: center;
			        box-shadow: 0 6px 16px rgba(16, 124, 65, 0.18);
			        position: relative;
			        overflow: hidden;
			    '>
			        <div style='position: absolute; right: -8px; bottom: -8px; opacity: 0.12; color: #107c41; pointer-events: none;'>
			            <svg width='65' height='65' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
			                <line x1='12' y1='1' x2='12' y2='23'></line>
			                <path d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'></path>
			            </svg>
			        </div>
			        <div style='display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 4px; width: 100%;'>
			            <div style='background-color: #107c41; color: #ffffff; padding: 4px; border-radius: 50%; display: flex; align-items: center; justify-content: center;'>
			                <svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'>
			                    <line x1='12' y1='1' x2='12' y2='23'></line>
			                    <path d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'></path>
			                </svg>
			            </div>
			            <span style='font-size: 10px; font-weight: 800; color: #0a4724; text-transform: uppercase; letter-spacing: 0.8px;'>Ventas Totales</span>
			        </div>
			        <div style='font-size: 19px; font-weight: 900; color: #063219; line-height: 1; letter-spacing: -0.3px;'>
			            " & ValorVentas & "
			        </div>
			    </div>
			
			    <!-- Tarjeta 2: Productos Vendidos -->
			    <div style='
			        background: linear-gradient(135deg, #ffffff 0%, #fff3e0 100%);
			        border: 1px solid #ffcc80;
			        border-top: 5px solid #d97706;
			        border-radius: 12px;
			        padding: 8px 12px;
			        width: 210px;
			        height: 72px;
			        box-sizing: border-box;
			        display: flex;
			        flex-direction: column;
			        justify-content: center;
			        align-items: center;
			        text-align: center;
			        box-shadow: 0 6px 16px rgba(217, 119, 6, 0.18);
			        position: relative;
			        overflow: hidden;
			    '>
			        <div style='position: absolute; right: -8px; bottom: -8px; opacity: 0.12; color: #d97706; pointer-events: none;'>
			            <svg width='65' height='65' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
			                <path d='M18 8h1a4 4 0 0 1 0 8h-1'></path>
			                <path d='M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z'></path>
			                <line x1='6' y1='1' x2='6' y2='4'></line>
			                <line x1='10' y1='1' x2='10' y2='4'></line>
			                <line x1='14' y1='1' x2='14' y2='4'></line>
			            </svg>
			        </div>
			        <div style='display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 4px; width: 100%;'>
			            <div style='background-color: #d97706; color: #ffffff; padding: 4px; border-radius: 50%; display: flex; align-items: center; justify-content: center;'>
			                <svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'>
			                    <path d='M18 8h1a4 4 0 0 1 0 8h-1'></path>
			                    <path d='M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z'></path>
			                </svg>
			            </div>
			            <span style='font-size: 10px; font-weight: 800; color: #78350f; text-transform: uppercase; letter-spacing: 0.8px;'>Productos Vendidos</span>
			        </div>
			        <div style='font-size: 19px; font-weight: 900; color: #451a03; line-height: 1; letter-spacing: -0.3px;'>
			            " & ValorProductos & "
			        </div>
			    </div>
			
			    <!-- Tarjeta 3: Calificación Promedio -->
			    <div style='
			        background: linear-gradient(135deg, #ffffff 0%, #fefce8 100%);
			        border: 1px solid #fde047;
			        border-top: 5px solid #ca8a04;
			        border-radius: 12px;
			        padding: 8px 12px;
			        width: 210px;
			        height: 72px;
			        box-sizing: border-box;
			        display: flex;
			        flex-direction: column;
			        justify-content: center;
			        align-items: center;
			        text-align: center;
			        box-shadow: 0 6px 16px rgba(202, 138, 4, 0.18);
			        position: relative;
			        overflow: hidden;
			    '>
			        <div style='position: absolute; right: -8px; bottom: -8px; opacity: 0.12; color: #ca8a04; pointer-events: none;'>
			            <svg width='65' height='65' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
			                <polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'></polygon>
			            </svg>
			        </div>
			        <div style='display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 4px; width: 100%;'>
			            <div style='background-color: #ca8a04; color: #ffffff; padding: 4px; border-radius: 50%; display: flex; align-items: center; justify-content: center;'>
			                <svg width='11' height='11' viewBox='0 0 24 24' fill='currentColor' stroke='none'>
			                    <polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'></polygon>
			                </svg>
			            </div>
			            <span style='font-size: 10px; font-weight: 800; color: #713f12; text-transform: uppercase; letter-spacing: 0.8px;'>Calificación Prom.</span>
			        </div>
			        <div style='font-size: 19px; font-weight: 900; color: #422006; line-height: 1; letter-spacing: -0.3px;'>
			            " & ValorRating & " <span style='font-size: 12px; font-weight: 700; color: #ca8a04;'>/ 5</span>
			        </div>
			    </div>
			
			    <!-- Tarjeta 4: Tiempo de Servicio -->
			    <div style='
			        background: linear-gradient(135deg, #ffffff 0%, #e8f5e9 100%);
			        border: 1px solid #a3e635;
			        border-top: 5px solid #107c41;
			        border-radius: 12px;
			        padding: 8px 12px;
			        width: 210px;
			        height: 72px;
			        box-sizing: border-box;
			        display: flex;
			        flex-direction: column;
			        justify-content: center;
			        align-items: center;
			        text-align: center;
			        box-shadow: 0 6px 16px rgba(16, 124, 65, 0.18);
			        position: relative;
			        overflow: hidden;
			    '>
			        <div style='position: absolute; right: -8px; bottom: -8px; opacity: 0.12; color: #107c41; pointer-events: none;'>
			            <svg width='65' height='65' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
			                <circle cx='12' cy='12' r='10'></circle>
			                <polyline points='12 6 12 12 16 14'></polyline>
			            </svg>
			        </div>
			        <div style='display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 4px; width: 100%;'>
			            <div style='background-color: #107c41; color: #ffffff; padding: 4px; border-radius: 50%; display: flex; align-items: center; justify-content: center;'>
			                <svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'>
			                    <circle cx='12' cy='12' r='10'></circle>
			                    <polyline points='12 6 12 12 16 14'></polyline>
			                </svg>
			            </div>
			            <span style='font-size: 10px; font-weight: 800; color: #0a4724; text-transform: uppercase; letter-spacing: 0.8px;'>Tiempo de Servicio</span>
			        </div>
			        <div style='display: flex; align-items: center; justify-content: center; gap: 6px;'>
			            <span style='font-size: 19px; font-weight: 900; color: #063219; line-height: 1; letter-spacing: -0.3px;'>
			                " & ValorEstado & "
			            </span>
			            <div style='display: flex; align-items: center;'>
			                " & IconoDinamico & "
			            </div>
			        </div>
			    </div>
			
			    <!-- Tarjeta 5: Crecimiento Mensual (%) -->
			    <div style='
			        background: linear-gradient(135deg, #ffffff 0%, " & ColorFondoCrecimiento & " 100%);
			        border: 1px solid " & ColorBordeCrecimiento & ";
			        border-top: 5px solid " & ColorCrecimiento & ";
			        border-radius: 12px;
			        padding: 8px 12px;
			        width: 210px;
			        height: 72px;
			        box-sizing: border-box;
			        display: flex;
			        flex-direction: column;
			        justify-content: center;
			        align-items: center;
			        text-align: center;
			        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
			        position: relative;
			        overflow: hidden;
			    '>
			        <div style='position: absolute; right: -8px; bottom: -8px; opacity: 0.12; color: " & ColorCrecimiento & "; pointer-events: none;'>
			            <svg width='65' height='65' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>
			                <polyline points='23 6 13.5 15.5 8.5 10.5 1 18'></polyline>
			                <polyline points='17 6 23 6 23 12'></polyline>
			            </svg>
			        </div>
			        <div style='display: flex; align-items: center; justify-content: center; gap: 6px; margin-bottom: 4px; width: 100%;'>
			            <div style='background-color: " & ColorCrecimiento & "; color: #ffffff; padding: 4px; border-radius: 50%; display: flex; align-items: center; justify-content: center;'>
			                <svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'>
			                    <polyline points='23 6 13.5 15.5 8.5 10.5 1 18'></polyline>
			                    <polyline points='17 6 23 6 23 12'></polyline>
			                </svg>
			            </div>
			            <span style='font-size: 10px; font-weight: 800; color: " & ColorCrecimiento & "; text-transform: uppercase; letter-spacing: 0.8px;'>Crecimiento Mensual</span>
			        </div>
			        <div style='display: flex; align-items: center; justify-content: center; gap: 6px;'>
			            <span style='font-size: 19px; font-weight: 900; color: " & ColorCrecimiento & "; line-height: 1; letter-spacing: -0.3px;'>
			                " & TextoCrecimiento & "
			            </span>
			            <div style='display: flex; align-items: center;'>
			                " & IconoCrecimiento & "
			            </div>
			        </div>
			    </div>
			</div>
			"
			```
		lineageTag: c595904f-2ffa-4e78-b429-98f3f146389a

