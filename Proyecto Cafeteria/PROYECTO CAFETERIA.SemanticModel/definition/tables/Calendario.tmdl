	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2023, 1, 1), INT(NOW()) + 460),
				    "Año", YEAR([Date]),
				    "Mes", MONTH([Date]),
				    "Día", DAY([Date]),
				    "mes_nom", FORMAT([Date], "mmm"),
				    "dia_nom", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = aa4be50a83c249f9a5c393c66054cc98

